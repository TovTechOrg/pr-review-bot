# Copy this file to .env and fill in real values. .env is gitignored.
# Credentials and identity ONLY. Operational settings (provider, model, usage
# caps, ...) live in .env.config -- see .env.config.example. An agent must
# never open this file; see CLAUDE.md's "Secret handling" section.

# --- Database ---
# Postgres connection string (Supabase or self-hosted). Also where
# bot/scripts/set_override.py writes the DB-backed provider override (see
# guide/operations/overrides.md) -- pointed at a local Postgres, that
# override is local only; it never reaches production unless this URL
# itself is the production one.
DATABASE_URL=

# --- GitHub App ---
# Numeric App ID: App settings -> General -> "App ID". See
# guide/setup/02-github-app.md, which also explains why this is not the
# Client ID or the Installation ID.
GITHUB_APP_ID=
# Required -- never auto-discovered/guessed on your behalf. Find it via
# bot/scripts/deploy.py's github-app check (or the GitHub UI's App installation
# page) after installing the App, then set it here.
GITHUB_APP_INSTALLATION_ID=
# Base64-encoded private key -- verbatim only, never a file path (kept out of
# git). Encode a local PEM with: uv run python -m bot.scripts.encode_credential
# path/to/github-app-private-key.pem
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Dashboard authentication ---
# Single shared operator credential gating the dashboard (GET / and its
# API). All three are required -- the service refuses to boot if any is
# empty. DASHBOARD_SESSION_SECRET signs the session cookie; generate a
# random value for it (it is not meant to be memorable, and must be at
# least 32 characters -- the service also refuses to boot with a shorter
# one), e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# DASHBOARD_PASSWORD is also worth generating the same way rather than
# picking something memorable: it's the only thing standing between the
# internet and this dashboard, and the ~1s per-request failure delay does
# not meaningfully slow a parallel/concurrent brute-force attempt.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Each credential below can have numbered siblings -- BASE_1, BASE_2, ... --
# swappable at runtime with no redeploy via `bot/scripts/set_override.py`'s
# key-index override (see README "Swapping API keys without a redeploy").
# Uncomment and fill in only the slots you actually plan to use; an unfilled
# slot is simply never selected, and adding one later needs one redeploy to
# provision (or a manual push -- see the Open Items note on that gap).

# gemini (AI-Studio, free tier, no card required)
GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=

# groq (free tier fallback / cross-vendor demo)
GROQ_API_KEY=
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=

# vertex (Vertex AI via google-genai's vertexai=True -- needs GCP billing)
# The credential is a GCP service-account JSON key -- base64-encoded,
# verbatim only, never a file path. Encode a local key file with:
# uv run python -m bot.scripts.encode_credential path/to/service-account-key.json
# With none of the slots below set, google-auth falls back to your own
# `gcloud auth application-default login` credentials.
VERTEX_GCP_SERVICE_ACCOUNT_KEY=
# VERTEX_GCP_SERVICE_ACCOUNT_KEY_1=
# VERTEX_GCP_SERVICE_ACCOUNT_KEY_2=

# --- Render & UptimeRobot (required) ---
# Render API key (Account Settings -> API Keys): required for the
# boot-creds-live/render-service/provider-live/api-key-live checks,
# `--sync-env`, and the deployed service's own dashboard Environment tab.
RENDER_API_KEY=
# UptimeRobot read-only API key: required for the uptime-pinger check.
UPTIMEROBOT_API_KEY=
